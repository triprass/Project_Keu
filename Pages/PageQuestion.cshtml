@page
@model Project_Keu.Pages.PageQuestionModel
@{
    // Tampilkan nama kategori di judul jika tersedia, jika tidak tampilkan judul umum
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model?.CategoryName)
        ? "Daftar Pertanyaan"
        : $"Daftar Pertanyaan Kategori [{Model.CategoryName}]";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet">
}

<div class="admin-page admin-page-v2">
    <div class="admin-page-overlay"></div>

    <header class="admin-header admin-header-v2">
        <a asp-page="/Index" class="admin-logo-link" aria-label="Kembali ke halaman utama">
            <img src="~/images/logo.png" alt="Logo Tanya Subbag Keuangan" class="admin-logo">
        </a>
    </header>

    @{
        // "Kembali" berarti kembali ke kartu kategori di /Pertanyaan. Pengelola yang
        // masuk lewat menu panel administrasi tidak datang dari sana, jadi tombol itu
        // tidak akan mengembalikannya ke mana pun — cukup tombol Dashboard.
        var arrivedFromCategoryCards = !Model.IsAdmin || Model.CategoryId.HasValue;
    }

    <nav class="admin-navbar admin-navbar-end" aria-label="Navigasi halaman daftar pertanyaan">
        @* Halaman ini tetap terbuka untuk umum. Jalan pintas ke panel administrasi
           hanya muncul bagi yang sudah masuk, sehingga tampilan publik tidak berubah. *@
        @if (Model.IsAdmin)
        {
            <a asp-page="/Admin/Index" class="app-btn app-btn-sm" aria-label="Buka panel administrasi">
                <svg class="app-btn-icon" viewBox="0 0 24 24" width="16" height="16"
                     fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <rect x="3" y="3" width="7.5" height="7.5" rx="1.5" />
                    <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5" />
                    <rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5" />
                    <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5" />
                </svg>
                <span>Dashboard</span>
            </a>
        }

        @if (arrivedFromCategoryCards)
        {
            <a asp-page="/Pertanyaan" class="app-btn app-btn-sm" aria-label="Kembali ke daftar pertanyaan">
                <svg class="app-btn-icon" viewBox="0 0 24 24" width="16" height="16"
                     fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <line x1="19" y1="12" x2="5" y2="12" />
                    <polyline points="12 19 5 12 12 5" />
                </svg>
                <span>Kembali</span>
            </a>
        }
    </nav>

    <section class="admin-table-wrap admin-table-wrap-v2">
        @* Judul mengikuti lingkup daftarnya, bukan peran pembacanya: ada kategori
           berarti daftarnya dibatasi kategori itu, siapa pun yang membuka. *@
        <div class="admin-table-title admin-table-title-v2">
            @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
            {
                <div>Daftar Pertanyaan</div>
                <div class="inv2-category-name">Kategori @Model.CategoryName</div>

                @* Pengelola perlu jalan keluar dari lingkup kategori: konteks halaman
                   sengaja tidak ikut dibersihkan tombol reset filter. *@
                if (Model.IsAdmin)
                {
            <a asp-page="/PageQuestion" class="inv2-scope-reset" title="Tampilkan pertanyaan dari semua kategori">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="6" y1="6" x2="18" y2="18" />
                    <line x1="18" y1="6" x2="6" y2="18" />
                </svg>
                Lihat semua kategori
            </a>
                }
            }
            else if (Model.IsAdmin)
            {
            <text>Daftar Seluruh Pertanyaan</text>
            }
            else
            {
            <text>Daftar Pertanyaan</text>
            }
        </div>

        <div class="inv2-page">
            <div class="inv2-shell">
                <div class="inv2-toolbar">
                    @* Hanya kotak pencarian global. Nilai filter lain tidak lagi
                       diduplikasi di sini; sumber tunggalnya adalah #filterForm. *@
                    <form method="post" class="inv2-toolbar-left" id="toolbarForm">
                        <div class="inv2-search-wrap">
                            <input type="text" id="globalSearchInput" name="Q" value="@Model.Q"
                                   placeholder="Cari question no, title, atau pertanyaan"
                                   maxlength="200" autocomplete="off" aria-label="Pencarian global" />
                            <button type="submit" aria-label="Cari">⌕</button>
                        </div>
                        <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
                        <input type="hidden" name="PageSize" value="@Model.PageSize" />
                        <input type="hidden" name="Page" value="1" />
                    </form>
                    @* Ikon SVG inline: tajam di layar beresolusi tinggi, mewarisi warna
                       tombol, dan tidak melanggar CSP seperti icon font dari CDN. *@
                    <button type="button" id="exportButton" class="inv2-export-btn"
                            title="Unduh daftar pertanyaan sesuai filter (Excel)">
                        <svg class="inv2-export-icon" viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                            <polyline points="7 10 12 15 17 10" />
                            <line x1="12" y1="15" x2="12" y2="3" />
                        </svg>
                        <svg class="inv2-export-spinner" viewBox="0 0 24 24" width="15" height="15"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" aria-hidden="true" focusable="false">
                            <circle cx="12" cy="12" r="9" opacity="0.25" />
                            <path d="M21 12a9 9 0 0 0-9-9" />
                        </svg>
                        <span class="inv2-export-label">Unduh</span>
                    </button>
                </div>

                @* Form terpisah untuk navigasi ke detail. Tombol pada setiap baris
                   memakai atribut form="detailForm" karena form tidak boleh bersarang. *@
                <form method="post" asp-page="/DetailPertanyaan" id="detailForm"></form>

                <div class="inv2-table-card">
                    <form method="post" id="filterForm">
                        @* CategoryId adalah konteks halaman (dari kartu kategori), bukan
                           filter yang bisa diubah pengguna, jadi tidak ikut dibersihkan
                           oleh tombol reset. Kosong berarti daftarnya lintas kategori. *@
                        <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
                        <input type="hidden" name="CreatedByEmployee" data-filter="hidden" value="@Model.CreatedByEmployee" />

                        <div class="inv2-table-wrap">
                            @* Kolom pengelola bertambah banyak, jadi lebar minimumnya
                               dinaikkan lewat kelas tersendiri; tanpa itu kolom
                               Pertanyaan dan Jawaban saling berebut ruang. *@
                            <table class="inv2-table@(Model.IsAdmin ? " inv2-table-admin" : string.Empty)">
                                @* Susunan kolom mengikuti peran pembaca. Pengelola melihat
                                   kolom lengkap seperti pada berkas unduhan; pengunjung
                                   umum melihat susunan ringkas yang sudah ada. *@
                                <thead>
                                    <tr class="inv2-head-label">
                                        <th style="width:52px;">No</th>
                                        @if (Model.IsAdmin)
                                        {
                                            <th style="width:126px;">No. Pertanyaan</th>
                                        }
                                        <th style="width:106px;">Tgl Dibuat</th>
                                        @if (Model.IsAdmin)
                                        {
                                            <th style="width:150px;">Judul</th>
                                        }
                                        @* Pertanyaan dan jawaban diberi lebar yang sama supaya
                                           terbaca sebagai sepasang kolom, bukan satu kolom
                                           utama dengan keterangan tambahan di sebelahnya. *@
                                        <th style="width:@(Model.IsAdmin ? "290px" : "400px");">Pertanyaan</th>
                                        <th style="width:@(Model.IsAdmin ? "290px" : "400px");">Jawaban</th>
                                        @if (Model.IsAdmin)
                                        {
                                            <th style="width:160px;">Kategori</th>
                                        }
                                        <th style="width:@(Model.IsAdmin ? "170px" : "190px");">Pegawai</th>
                                        <th style="width:140px;">Status</th>
                                        <th style="width:46px;"></th>
                                    </tr>
                                    <tr class="inv2-head-filter">
                                        <th></th>

                                        @if (Model.IsAdmin)
                                        {
                                            <th>
                                                <input type="text" name="QuestionNoKeyword" data-filter="text"
                                                       value="@Model.QuestionNoKeyword" placeholder="Cari nomor"
                                                       autocomplete="off" aria-label="Filter nomor pertanyaan" />
                                            </th>
                                        }

                                        <th>
                                            @* Rentang tanggal: DateFrom/DateTo sudah didukung server tetapi
                                               sebelumnya hanya ada sebagai hidden field tanpa kontrol. *@
                                            <div class="inv2-date-grid">
                                                <input type="date" name="DateFrom" data-filter="instant"
                                                       value="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                                                       aria-label="Tanggal dibuat dari" title="Dari tanggal" />
                                                <input type="date" name="DateTo" data-filter="instant"
                                                       value="@Model.DateTo?.ToString("yyyy-MM-dd")"
                                                       aria-label="Tanggal dibuat sampai" title="Sampai tanggal" />
                                            </div>
                                        </th>

                                        @if (Model.IsAdmin)
                                        {
                                            <th>
                                                <input type="text" name="TitleKeyword" data-filter="text"
                                                       value="@Model.TitleKeyword" placeholder="Cari judul"
                                                       maxlength="200" autocomplete="off" aria-label="Filter judul" />
                                            </th>
                                        }

                                        <th>
                                            <input type="text" name="QuestionKeyword" data-filter="text"
                                                   value="@Model.QuestionKeyword" placeholder="Cari pertanyaan"
                                                   maxlength="200" autocomplete="off" aria-label="Filter pertanyaan" />
                                        </th>

                                        <th>
                                            <input type="text" name="AnswerKeyword" data-filter="text"
                                                   value="@Model.AnswerKeyword" placeholder="Cari jawaban"
                                                   maxlength="200" autocomplete="off" aria-label="Filter jawaban" />
                                        </th>

                                        @if (Model.IsAdmin)
                                        {
                                            <th>
                                                <input type="text" name="CategoryKeyword" data-filter="text"
                                                       value="@Model.CategoryKeyword" placeholder="Cari kategori"
                                                       maxlength="200" autocomplete="off" aria-label="Filter kategori" />
                                            </th>
                                        }

                                        <th>
                                            <input type="text" name="EmployeeKeyword" data-filter="text"
                                                   value="@Model.EmployeeKeyword" placeholder="Cari pegawai / NIP"
                                                   maxlength="200" autocomplete="off" aria-label="Filter pegawai atau NIP" />
                                        </th>
                                        <th>
                                            <select name="StatusId" data-filter="instant" aria-label="Filter status">
                                                <option value="">Semua status</option>
                                                @foreach (var status in Model.StatusOptions)
                                                {
                                                    if (Model.StatusId?.ToString() == status.Value)
                                                    {
                                                        <option value="@status.Value" selected>@status.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@status.Value">@status.Text</option>
                                                    }
                                                }
                                            </select>
                                        </th>
                                        <th class="inv2-filter-actions">
                                            <div class="inv2-filter-btns">
                                                <button type="button" id="resetFilterButton" title="Bersihkan semua filter" aria-label="Bersihkan semua filter" disabled>✕</button>
                                            </div>
                                        </th>
                                    </tr>
                                </thead>

                                <tbody id="questionsTbody" aria-busy="true" aria-live="polite">
                                    <tr>
                                        <td colspan="@(Model.IsAdmin ? 9 : 6)" class="inv2-empty">Memuat data...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <input type="hidden" name="Page" id="pageInput" value="1" />

                        <div class="inv2-footer">
                            <div class="inv2-left">
                                Jumlah Baris:
                                <select name="PageSize" id="pageSizeSelect" aria-label="Jumlah baris per halaman">
                                    @if (Model.PageSize == 10) { <option value="10" selected>10</option> } else { <option value="10">10</option> }
                                    @if (Model.PageSize == 20) { <option value="20" selected>20</option> } else { <option value="20">20</option> }
                                    @if (Model.PageSize == 50) { <option value="50" selected>50</option> } else { <option value="50">50</option> }
                                    @if (Model.PageSize == 100) { <option value="100" selected>100</option> } else { <option value="100">100</option> }
                                </select>
                            </div>

                            <div class="inv2-pages" id="pagination">
                                <!-- Render oleh JS -->
                            </div>

                            <div class="inv2-right" id="tableRange">
                                Menampilkan 0 hingga 0 dari 0 entri
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <script>
        (function () {
            const tbody = document.getElementById('questionsTbody');
            const paginationEl = document.getElementById('pagination');
            const tableRangeEl = document.getElementById('tableRange');

            const filterForm = document.getElementById('filterForm');
            const toolbarForm = document.getElementById('toolbarForm');
            const pageInput = document.getElementById('pageInput');
            const exportButton = document.getElementById('exportButton');

            const globalSearchInput = document.getElementById('globalSearchInput');
            const resetFilterButton = document.getElementById('resetFilterButton');
            const pageSizeSelect = document.getElementById('pageSizeSelect');

            // Pengelola melihat kolom lengkap; pengunjung umum melihat susunan ringkas.
            // Nilainya ditentukan server agar sama persis dengan <thead> yang dirender.
            const IS_ADMIN = @(Model.IsAdmin ? "true" : "false");
            const COLUMN_COUNT = IS_ADMIN ? 10 : 7;
            const DEBOUNCE_MS = 400;

            const numberFields = ['Page', 'PageSize'];
            const dateFields = ['CreatedDate', 'DateFrom', 'DateTo'];

            // Kontrol yang dianggap "filter" - dibersihkan tombol reset dan
            // dipakai untuk menentukan apakah ada filter yang sedang aktif.
            // CategoryId sengaja tidak diberi data-filter karena itu konteks halaman.
            const filterControls = [
                ...filterForm.querySelectorAll('[data-filter]'),
                globalSearchInput
            ].filter(Boolean);

            let requestSequence = 0;
            let inFlightController = null;
            let debounceTimer = null;

            // FormData -> object JSON (camelCase) untuk dikirim di request body,
            // bukan sebagai query string.
            function toPayload(params) {
                const payload = {};
                for (const [k, v] of params.entries()) {
                    if (k === '__RequestVerificationToken') continue;
                    if (v === null || v === undefined) continue;
                    const s = String(v).trim();
                    if (!s) continue;

                    const key = k.charAt(0).toLowerCase() + k.slice(1);

                    if (numberFields.includes(k)) {
                        const n = Number(s);
                        if (Number.isFinite(n)) payload[key] = n;
                        continue;
                    }

                    if (dateFields.includes(k)) {
                        // Input type=date memberi "yyyy-MM-dd"; server memperlakukannya
                        // sebagai tanggal lokal, jadi tidak boleh diberi penanda UTC.
                        if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) continue;
                        payload[key] = `${s}T00:00:00`;
                        continue;
                    }

                    payload[key] = s;
                }
                return payload;
            }

            // Isi pertanyaan & nama pegawai berasal dari input pengguna, jadi harus
            // di-escape sebelum masuk innerHTML agar tidak bisa menyisipkan markup.
            function escapeHtml(value) {
                return String(value ?? '')
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#39;');
            }

            function hasActiveFilter() {
                return filterControls.some(el => String(el.value ?? '').trim() !== '');
            }

            function updateResetButton() {
                const active = hasActiveFilter();
                resetFilterButton.disabled = !active;
                resetFilterButton.classList.toggle('is-active', active);
            }

            function showTableMessage(message, actionLabel) {
                const action = actionLabel
                    ? `<div class="inv2-empty-action"><button type="button" data-empty-action="1">${escapeHtml(actionLabel)}</button></div>`
                    : '';

                tbody.innerHTML =
                    `<tr><td colspan="${COLUMN_COUNT}" class="inv2-empty">${escapeHtml(message)}${action}</td></tr>`;
            }

            function renderRows(result) {
                const questions = result?.questions ?? [];

                if (!questions.length) {
                    // Bedakan "memang belum ada isinya" dari "filter tidak menemukan apa pun",
                    // supaya pengguna tahu apakah perlu mengubah filter.
                    if ((result?.totalUnfiltered ?? 0) === 0) {
                        showTableMessage('Belum ada pertanyaan pada daftar ini.');
                    } else {
                        showTableMessage('Tidak ada data yang cocok dengan filter.', 'Bersihkan filter');
                    }
                    return;
                }

                const offset = ((result?.page ?? 1) - 1) * (result?.pageSize ?? 10);

                tbody.innerHTML = questions.map((q, index) => {
                    const rowNumber = offset + index + 1;

                    const status = q?.statusName ?? '-';

                    // Golongan ditentukan server. Aturan lama memeriksa apakah nama
                    // status mengandung "jawab", dan itu benar untuk "Telah Dijawab"
                    // maupun "Belum Dijawab" sehingga keduanya berwarna sama.
                    const statusKind = q?.statusKind ?? 'neutral';
                    const kindClass = {
                        answered: 'inv2-badge-success',
                        pending: 'inv2-badge-warn'
                    }[statusKind] ?? '';

                    // Server sudah menyaring nilai warnanya, sehingga aman ditulis ke
                    // atribut style.
                    const statusColor = q?.statusColor ? escapeHtml(q.statusColor) : '';

                    // Sudah dijawab vs belum dijawab harus selalu berbeda warna, jadi
                    // hijau/jingga itu yang menentukan tampilan lencana. Warna pilihan
                    // pengelola tetap terpakai sebagai titik penanda — sebelumnya warna
                    // itu mengambil alih seluruh lencana, dan nilai semuda #BDBDBD
                    // membuat kedua status nyaris seragam kelabu. Status di luar kedua
                    // golongan itulah yang seluruh lencananya mengikuti warna master.
                    let statusBadge;

                    if (kindClass) {
                        const dot = statusColor
                            ? `<span class="inv2-badge-dot" style="background:${statusColor};"></span>`
                            : '<span class="inv2-badge-dot"></span>';
                        statusBadge = `<span class="inv2-badge ${kindClass}">${dot}${escapeHtml(status)}</span>`;
                    } else if (statusColor) {
                        statusBadge = `<span class="inv2-badge inv2-badge-custom" style="border-color:${statusColor};"><span class="inv2-badge-dot" style="background:${statusColor};"></span>${escapeHtml(status)}</span>`;
                    } else {
                        statusBadge = `<span class="inv2-badge inv2-badge-neutral"><span class="inv2-badge-dot"></span>${escapeHtml(status)}</span>`;
                    }

                    const pertanyaan = escapeHtml(q?.questionText ?? '-');

                    // Kolom jawaban dibedakan dari "jawabannya kebetulan kosong":
                    // baris yang belum dijawab diberi teks penanda, bukan sel kosong
                    // yang menyisakan lubang di tengah tabel.
                    const jawabanRaw = String(q?.answerText ?? '').trim();
                    const jawaban = jawabanRaw
                        ? `<span title="${escapeHtml(jawabanRaw)}">${escapeHtml(jawabanRaw)}</span>`
                        : '<span class="inv2-answer-empty">Belum ada jawaban</span>';
                    // Tanggal diformat server pada zona waktu aplikasi, sehingga sama
                    // dengan tanggal yang dipakai filter apa pun zona waktu browser.
                    const tglDibuat = escapeHtml(q?.createdAtDisplay || '-');
                    const pegawai = escapeHtml(q?.employeeName ?? '-');

                    // Id dikirim sebagai value tombol submit ke #detailForm (POST),
                    // bukan sebagai query string.
                    const detailLink =
                        `<button type="submit" form="detailForm" name="Id" value="${escapeHtml(q?.id ?? '')}" class="inv2-question-link" title="${pertanyaan}">${pertanyaan}</button>`;

                    // Sel disusun sebagai daftar supaya urutannya tidak bisa melenceng
                    // dari <thead>; jumlahnya selalu sama dengan COLUMN_COUNT.
                    const cells = [
                        `<td>${rowNumber}</td>`
                    ];

                    if (IS_ADMIN) {
                        cells.push(`<td>${escapeHtml(q?.questionNo || '-')}</td>`);
                    }

                    cells.push(`<td>${tglDibuat}</td>`);

                    if (IS_ADMIN) {
                        const judul = escapeHtml(q?.title || '-');
                        cells.push(`<td class="inv2-title" title="${judul}">${judul}</td>`);
                    }

                    cells.push(`<td class="inv2-question">${detailLink}</td>`);
                    cells.push(`<td class="inv2-answer">${jawaban}</td>`);

                    if (IS_ADMIN) {
                        cells.push(`<td>${escapeHtml(q?.categoryName || '-')}</td>`);
                    }

                    cells.push(`<td>${pegawai}</td>`);
                    cells.push(`<td>${statusBadge}</td>`);
                    cells.push('<td class="inv2-kebab">⋮</td>');

                    // Garis warna tipis di tepi kiri baris: pembeda status yang masih
                    // terbaca meski kolom Status tergulir keluar layar.
                    return `<tr data-status-kind="${escapeHtml(statusKind)}">${cells.join('')}</tr>`;
                }).join('');
            }

            function renderPagination(result) {
                const totalPages = result?.totalPages ?? 1;
                const page = result?.page ?? 1;

                const maxLinks = 2; // tampilkan +/- 2 sekitar halaman aktif
                const start = Math.max(1, page - maxLinks);
                const end = Math.min(totalPages, page + maxLinks);

                let html = '';

                function pageLink(label, targetPage, disabled) {
                    if (disabled) return `<span class="active" style="opacity:.6; pointer-events:none;">${label}</span>`;
                    return `<a href="#" data-page="${targetPage}">${label}</a>`;
                }

                html += pageLink('‹', Math.max(1, page - 1), page <= 1);

                for (let p = start; p <= end; p++) {
                    if (p === page) html += `<span class="active">${p}</span>`;
                    else html += `<a href="#" data-page="${p}">${p}</a>`;
                }

                html += pageLink('›', Math.min(totalPages, page + 1), page >= totalPages);

                paginationEl.innerHTML = html;
            }

            function renderRange(result) {
                const totalItems = result?.totalItems ?? 0;
                const page = result?.page ?? 1;
                const pageSize = result?.pageSize ?? 10;

                const startItem = totalItems === 0 ? 0 : ((page - 1) * pageSize) + 1;
                const endItem = totalItems === 0 ? 0 : Math.min(page * pageSize, totalItems);

                tableRangeEl.textContent = `Menampilkan ${startItem} hingga ${endItem} dari ${totalItems} entri`;
            }

            // Kumpulkan filter yang sedang aktif menjadi satu payload JSON.
            // #filterForm adalah satu-satunya sumber nilai; kotak pencarian global
            // ditambahkan di sini, tidak lagi diduplikasi sebagai hidden field.
            function currentPayload() {
                const formData = new FormData(filterForm);

                formData.set('Page', pageInput.value || '1');

                if (globalSearchInput) {
                    formData.set('Q', globalSearchInput.value || '');
                }

                return toPayload(formData);
            }

            async function loadQuestions() {
                // Permintaan sebelumnya dibatalkan, dan hasil yang datang terlambat
                // diabaikan lewat nomor urut. Tanpa ini, mengetik cepat pada filter
                // bisa membuat respons lama menimpa hasil terbaru.
                if (inFlightController) {
                    inFlightController.abort();
                }

                const controller = new AbortController();
                inFlightController = controller;

                const sequence = ++requestSequence;
                const payload = currentPayload();

                tbody.setAttribute('aria-busy', 'true');
                showTableMessage('Memuat data...');

                try {
                    const response = await fetch('/api/page-question/questions', {
                        method: 'POST',
                        cache: 'no-cache',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload),
                        signal: controller.signal
                    });

                    if (!response.ok) {
                        throw Object.assign(new Error(`HTTP ${response.status}`), { status: response.status });
                    }

                    const result = await response.json();

                    if (sequence !== requestSequence) return;

                    // Server bisa menjepit nomor halaman (mis. filter mengurangi jumlah
                    // halaman), jadi nilai balikannya yang dipakai, bukan nilai kiriman.
                    pageInput.value = String(result?.page ?? 1);

                    renderRows(result);
                    renderPagination(result);
                    renderRange(result);
                } catch (error) {
                    if (error.name === 'AbortError' || sequence !== requestSequence) return;

                    const message = error.status === 429
                        ? 'Terlalu banyak permintaan. Tunggu sebentar lalu coba lagi.'
                        : 'Gagal memuat data.';

                    showTableMessage(message, 'Coba lagi');
                    paginationEl.innerHTML = '';
                    tableRangeEl.textContent = 'Menampilkan 0 hingga 0 dari 0 entri';
                    console.error('Fetch error:', error);
                } finally {
                    if (sequence === requestSequence) {
                        tbody.setAttribute('aria-busy', 'false');
                        inFlightController = null;
                    }
                }
            }

            // Setiap perubahan filter selalu kembali ke halaman 1; kalau tidak,
            // pengguna bisa terdampar di halaman kosong setelah hasil menyusut.
            function applyFilters() {
                clearTimeout(debounceTimer);
                pageInput.value = '1';
                updateResetButton();
                loadQuestions();
            }

            function scheduleApplyFilters() {
                clearTimeout(debounceTimer);
                updateResetButton();
                debounceTimer = setTimeout(applyFilters, DEBOUNCE_MS);
            }

            function resetFilters() {
                filterControls.forEach(el => { el.value = ''; });
                applyFilters();
            }

            // Filter teks: ditunda supaya tidak mengirim satu permintaan per ketikan.
            // Dropdown dan tanggal: langsung diterapkan.
            filterForm.querySelectorAll('[data-filter="text"]').forEach(el => {
                el.addEventListener('input', scheduleApplyFilters);
            });

            filterForm.querySelectorAll('[data-filter="instant"]').forEach(el => {
                el.addEventListener('change', applyFilters);
            });

            if (globalSearchInput) {
                globalSearchInput.addEventListener('input', scheduleApplyFilters);
            }

            // Enter menerapkan segera (tidak menunggu jeda), Escape mengosongkan kolom itu.
            [...filterForm.querySelectorAll('[data-filter]'), globalSearchInput]
                .filter(Boolean)
                .forEach(el => {
                    el.addEventListener('keydown', function (ev) {
                        if (ev.key === 'Enter') {
                            ev.preventDefault();
                            applyFilters();
                        } else if (ev.key === 'Escape' && el.value) {
                            ev.preventDefault();
                            el.value = '';
                            applyFilters();
                        }
                    });
                });

            resetFilterButton.addEventListener('click', resetFilters);

            pageSizeSelect.addEventListener('change', applyFilters);

            // Tombol di dalam pesan tabel kosong / gagal.
            tbody.addEventListener('click', function (ev) {
                const button = ev.target.closest('button[data-empty-action]');
                if (!button) return;

                if (button.textContent.trim() === 'Bersihkan filter') {
                    resetFilters();
                } else {
                    loadQuestions();
                }
            });

            // Kedua form dirender oleh JS; submit biasa dicegah agar halaman tidak reload.
            filterForm.addEventListener('submit', function (ev) {
                ev.preventDefault();
                applyFilters();
            });

            toolbarForm.addEventListener('submit', function (ev) {
                ev.preventDefault();
                applyFilters();
            });

            // Unduh CSV memakai filter yang sedang aktif. Tombol ini sebelumnya
            // hanya menautkan ke halaman utama dan tidak mengunduh apa pun.
            if (exportButton) {
                // Hanya label teks yang diganti; isi tombol tidak ditimpa supaya
                // ikon SVG dan spinner di dalamnya tetap utuh.
                const exportLabel = exportButton.querySelector('.inv2-export-label');

                function setExportLoading(isLoading) {
                    exportButton.disabled = isLoading;
                    exportButton.classList.toggle('is-loading', isLoading);
                    if (exportLabel) {
                        exportLabel.textContent = isLoading ? 'Menyiapkan...' : 'Unduh';
                    }
                }

                exportButton.addEventListener('click', async function () {
                    setExportLoading(true);

                    try {
                        const response = await fetch('/api/page-question/questions/export', {
                            method: 'POST',
                            cache: 'no-cache',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(currentPayload())
                        });

                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}`);
                        }

                        const blob = await response.blob();
                        const objectUrl = URL.createObjectURL(blob);
                        const link = document.createElement('a');

                        link.href = objectUrl;
                        link.download = `daftar-pertanyaan-${new Date().toISOString().slice(0, 10)}.xlsx`;
                        document.body.appendChild(link);
                        link.click();
                        link.remove();
                        URL.revokeObjectURL(objectUrl);
                    } catch (error) {
                        console.error('Export error:', error);
                        alert('Gagal mengunduh data. Silakan coba lagi.');
                    } finally {
                        setExportLoading(false);
                    }
                });
            }

            // Pagination click - satu-satunya jalur yang TIDAK mereset halaman.
            paginationEl.addEventListener('click', function (ev) {
                const a = ev.target.closest('a[data-page]');
                if (!a) return;
                ev.preventDefault();
                const p = a.getAttribute('data-page');
                if (p) {
                    pageInput.value = String(p);
                    loadQuestions();
                }
            });

            // Initial load
            updateResetButton();
            loadQuestions();
        })();
    </script>
</div>
