@page
@model Project_Keu.Pages.FormPertanyaanModel
@{
    ViewData["Title"] = "Formulir Pertanyaan";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet">
}

<div class="form-page">
    <div class="form-page-overlay"></div>

    @* <section class="question-search-wrap" aria-label="">
        <div class="search-replacement">
            <a asp-page="/Pertanyaan" class="btn-kembali">Kembali</a>
        </div>
    </section> *@

    @* <nav class="admin-navbar admin-navbar-left" aria-label="Navigasi halaman daftar pertanyaan">
        <a href="javascript:history.back()" class="btn-kembali">Kembali</a>
    </nav> *@

    <div class="form-layout">
        <section class="form-card" aria-label="Formulir pertanyaan">
            <h1>Formulir Pertanyaan</h1>

            <form class="professional-form" method="post">
                <div asp-validation-summary="ModelOnly" class="form-warning"></div>

                <div class="form-group">
                    <label for="pertanyaanInput">Pertanyaan</label>
                    <textarea id="pertanyaanInput" name="Pertanyaan" rows="3" placeholder="Tuliskan pertanyaan Anda..." required>@Model.Pertanyaan</textarea>
                </div>

                <div class="form-group">
                    <label for="categoryInput">Kategori</label>
                    <select id="categoryInput" name="CategoryId" required>
                        <option value="">-- Pilih kategori --</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="nipInput">NIP Pendek</label>
                    <input id="nipInput" name="Nip" type="text" placeholder="Masukkan NIP Pendek" autocomplete="off" value="@Model.Nip" required>
                    <small id="nipWarning" class="form-warning" style="display:none; color:red">Mohon cek kembali NIP Pendek yang dimasukkan.</small>
                </div>

                <div class="form-group">
                    <label for="namaInput">Nama</label>
                    <input id="namaInput" name="Nama" type="text" placeholder="Nama akan terisi otomatis dari NIP Pendek" value="@Model.Nama" disabled>
                    <input id="employeeIdInput" name="EmployeeId" type="hidden" value="@Model.EmployeeId">
                </div>

                <div class="form-group">
                    <label for="UnitKerjaInput">Unit Kerja</label>
                    <input id="UnitKerjaInput" name="UnitKerja" type="text" placeholder="Unit Kerja akan terisi otomatis dari NIP Pendek" disabled>
                    <input id="employeeIdInput" name="EmployeeId" type="hidden" value="@Model.EmployeeId">
                </div>

                <button type="submit" class="form-submit-btn">Kirim</button>
                @* <button type="button" class="btn-kembali">Batalkan</button> *@
                <a asp-page="/Pertanyaan" class="btn-kembali" style="text-align: center">Batalkan</a>
                @*<p class="form-footnote">Data akan diproses secara aman. Hindari mengisi informasi sensitif seperti password.</p>*@
            </form>
        </section>
    </div>


    @*     <a asp-page="/Index" class="badge-hexagon">FORM-Q PAGE<br>(USER POV)</a> *@
</div>

@section Scripts {
    <script>
        (function () {
            const nipInput = document.getElementById('nipInput');
            const namaInput = document.getElementById('namaInput');
            const UnitKerjaInput = document.getElementById('UnitKerjaInput');
            const employeeIdInput = document.getElementById('employeeIdInput');

            let debounceTimer = null;

            const nipWarning = document.getElementById('nipWarning');

            function resetEmployeeFields(showWarning = false) {
                namaInput.value = '';
                namaInput.disabled = true;
                
                UnitKerjaInput.value = '';
                UnitKerjaInput.disabled = true;

                employeeIdInput.value = '';
                nipWarning.style.display = showWarning ? 'block' : 'none';
            }

            async function lookupByNip(nip) {
                const response = await fetch(`/api/employees/by-nip/${encodeURIComponent(nip)}`);
                if (!response.ok) {
                    resetEmployeeFields(true);
                    return;
                }

                const data = await response.json();
                namaInput.value = data.fullName ?? data.FullName ?? '';
                UnitKerjaInput.value = data.branch ?? data.Branch ?? '';
                employeeIdInput.value = data.id ?? data.Id ?? '';
                namaInput.disabled = true;
                UnitKerjaInput.disabled = true;
                nipWarning.style.display = 'none';
            }

            nipInput.addEventListener('input', function () {
                const nip = (nipInput.value || '').trim();

                clearTimeout(debounceTimer);

                if (!nip) {
                    resetEmployeeFields();
                    return;
                }

                debounceTimer = setTimeout(async () => {
                    try {
                        await lookupByNip(nip);
                    } catch {
                        resetEmployeeFields();
                    }
                }, 350);
            });

            resetEmployeeFields();
        })();
    </script>
}
