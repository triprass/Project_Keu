@page
@model Project_Keu.Pages.PertanyaanModel

@{
    ViewData["Title"] = "Daftar Pertanyaan";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet">
}

<div class="question-page">
    <div class="question-overlay"></div>

    <header class="question-header">
        <div class="page-container header-inner">
        <a asp-page="/Index" class="question-logo-link" aria-label="Kembali ke halaman utama">
            <img src="~/images/logo.png" alt="Logo Tanya Subbag Keuangan" class="question-logo">
        </a>
        @* Tombol 'Buat Pertanyaan' dipindahkan ke area pencarian (di bawah). *@
        </div>
    </header>

    

    <div class="page-container">

    <section class="question-search-wrap" aria-label="Pencarian pertanyaan">
        @* Search box removed; place 'Buat Pertanyaan' button here instead. *@
        <div class="search-replacement">
            <a asp-page="/FormPertanyaan" class="btn-buat-pertanyaan">Buat Pertanyaan Baru</a>
        </div>
    </section>
    </div>

    <div class="page-container">
    <section aria-label="Daftar kategori akun">
        <h2 class="kategori-judul">Jelajahi Semua Kategori</h2>

        <div class="category-grid">
            @if (Model.QuestionGroups.Any())
            {
                foreach (var group in Model.QuestionGroups)
                {
                    <article class="category-card">
                        <a asp-page="/PageQuestion" asp-route-CategoryId="@group.CategoryId" asp-route-PageSize="10" asp-route-Page="1" class="category-card-link">
                            <div class="card-inner">
                            <div class="card-icon" aria-hidden="true">
                                @* Placeholder SVG icon; replace with per-category image if available *@
                                <svg width="84" height="84" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="2" y="10" width="60" height="44" rx="6" stroke="#1AA76E" stroke-width="2" fill="rgba(26,167,110,0.06)" />
                                    <path d="M18 24h28" stroke="#1AA76E" stroke-width="2" stroke-linecap="round" />
                                    <path d="M18 32h18" stroke="#1AA76E" stroke-width="2" stroke-linecap="round" />
                                </svg>
                            </div>

                            <div class="card-body">
                                <div class="title-pill">@group.CategoryName</div>
                                <p class="card-desc">Informasi umum seputar @group.CategoryName</p>
                            </div>
                        </div>
                        </a>
                    </article>
                }
            }
            else
            {
                <article class="category-card empty">
                    <div class="card-inner">
                        <div class="card-icon" aria-hidden="true">
                            <svg width="84" height="84" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="32" cy="32" r="28" stroke="#d1d5db" stroke-width="2" fill="#f8fafc" />
                            </svg>
                        </div>
                        <div class="card-body">
                            <div class="title-pill">Belum ada kategori</div>
                            <p class="card-desc">Belum ada pertanyaan yang tersedia.</p>
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>
    </div>
 
@*     <a asp-page="/Index" class="badge-hexagon">Main Page</a> *@
</div>
