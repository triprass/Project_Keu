@page
@model Project_Keu.Pages.PertanyaanModel

@{
    ViewData["Title"] = "Daftar Pertanyaan";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet">
}

<div class="question-page">
    <div class="question-overlay"></div>

    <header class="question-header">
        <a asp-page="/Index" class="question-logo-link" aria-label="Kembali ke halaman utama">
            <img src="~/images/logo.png" alt="Logo Tanya Subbag Keuangan" class="question-logo">
        </a>

        <a asp-page="/FormPertanyaan" class="btn-buat-pertanyaan">Buat Pertanyaan</a>
    </header>

    <section class="question-search-wrap" aria-label="Pencarian pertanyaan">
        <form method="get" asp-page="/Pertanyaan" class="search-box" role="search">
            <span class="search-icon">🔍</span>
            <input name="q" type="text" placeholder="Cari pertanyaan..." aria-label="Cari pertanyaan" value="@Model.SearchQuery" />
            <button type="submit" class="search-submit" aria-label="Cari">🔎</button>
            <a asp-page="/Pertanyaan" class="search-close" aria-label="Bersihkan pencarian">✕</a>
        </form>
    </section>

    <section class="akun-grid" aria-label="Daftar kategori akun">
        @if (Model.QuestionGroups.Any())
        {
            foreach (var group in Model.QuestionGroups)
            {
                <article class="akun-card">
                    <h2>@group.CategoryName</h2>
                    <ul>
                        @foreach (var question in group.Questions)
                        {
                            <li>@question.QuestionText</li>
                        }
                    </ul>
                    <form method="post" asp-page="/PageQuestion" class="akun-card-more-form">
                        <input type="hidden" name="CategoryId" value="@group.CategoryId" />
                        <input type="hidden" name="PageSize" value="10" />
                        <input type="hidden" name="Page" value="1" />
                        <button type="submit" class="btn-lebih-banyak">Tampilkan lebih banyak</button>
                    </form>
                </article>
            }
        }
        else
        {
            <article class="akun-card">
                <h2>Belum ada data</h2>
                <ul>
                    <li>Belum ada pertanyaan yang tersedia.</li>
                </ul>
            </article>
        }
    </section>
 
@*     <a asp-page="/Index" class="badge-hexagon">Main Page</a> *@
</div>
