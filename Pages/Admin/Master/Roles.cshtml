@page
@model Project_Keu.Pages.Admin.Master.RolesModel
@{
    ViewData["Title"] = "Peran";
    ViewData["Lead"] = "Peran adalah sekumpulan izin yang diberikan bersama-sama kepada akun admin.";

    var isEdit = Model.Input.Id is not null && Model.Input.Id != Guid.Empty;
}

<section class="adm-card">

    <div class="adm-toolbar">
        <form method="get" class="adm-search" data-auto-submit role="search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" /><line x1="16.5" y1="16.5" x2="21" y2="21" />
            </svg>
            <input type="search" name="q" value="@Model.Search" data-auto="text"
                   placeholder="Cari kode, nama, atau keterangan peran" maxlength="100"
                   autocomplete="off" aria-label="Cari peran" />
        </form>

        <div class="adm-toolbar-actions">
            <button type="button" class="adm-btn adm-btn-primary"
                    data-modal-open="roleDialog" data-mode="create" data-title="Tambah Peran"
                    data-field-id="" data-field-code="" data-field-name="" data-field-description=""
                    data-field-isactive="true" data-checked="">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Tambah Peran
            </button>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="adm-empty">
            <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3 5 6v5.5c0 4.3 2.9 8.3 7 9.5 4.1-1.2 7-5.2 7-9.5V6l-7-3z" />
            </svg>
            @if (Model.HasSearch)
            {
                <strong>Tidak ada hasil</strong>
                <p>Tidak ada peran yang cocok dengan kata kunci &ldquo;@Model.Search&rdquo;.</p>
            }
            else
            {
                <strong>Belum ada peran</strong>
                <p>Buat peran lebih dulu agar akun admin dapat diberi hak akses.</p>
            }
        </div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th class="adm-td-num">No</th>
                        <th>Kode</th>
                        <th>Nama</th>
                        <th>Keterangan</th>
                        <th>Izin</th>
                        <th>Akun</th>
                        <th>Status</th>
                        <th class="adm-td-actions">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rowNumber = Model.RowOffset; }
                    @foreach (var item in Model.Items)
                    {
                        rowNumber++;

                        <tr>
                            <td class="adm-td-num">@rowNumber</td>
                            <td data-label="Kode"><span class="adm-code">@item.Code</span></td>
                            <td data-label="Nama">
                                <span class="adm-strong">@item.Name</span>
                                @if (item.IsSuperAdmin)
                                {
                                    <br />
                                    <span class="adm-badge adm-badge-warn">Bawaan sistem</span>
                                }
                            </td>
                            <td data-label="Keterangan">
                                <span class="adm-clamp adm-muted">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</span>
                            </td>
                            <td data-label="Izin">
                                @if (item.IsSuperAdmin)
                                {
                                    <span class="adm-badge adm-badge-on" title="Selalu memiliki seluruh izin, termasuk izin yang ditambahkan kemudian">
                                        Seluruh izin
                                    </span>
                                }
                                else
                                {
                                    <span class="adm-badge adm-badge-info">@item.PermissionCount izin</span>
                                }
                            </td>
                            <td data-label="Akun"><span class="adm-badge adm-badge-info">@item.UserCount akun</span></td>
                            <td data-label="Status">
                                <span class="adm-badge @(item.IsActive ? "adm-badge-on" : "adm-badge-off")">
                                    <span class="adm-badge-dot"></span>@(item.IsActive ? "Aktif" : "Nonaktif")
                                </span>
                            </td>
                            <td class="adm-td-actions" data-label="Aksi">
                                <span class="adm-row-actions">
                                    <button type="button" class="adm-btn adm-btn-icon" title="Ubah"
                                            data-modal-open="roleDialog" data-mode="edit" data-title="Ubah Peran"
                                            data-field-id="@item.Id"
                                            data-field-code="@item.Code"
                                            data-field-name="@item.Name"
                                            data-field-description="@item.Description"
                                            data-field-isactive="@item.IsActive.ToString().ToLowerInvariant()"
                                            data-checked="@string.Join(",", item.PermissionIds)">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7.5 18.5 3 20l1.5-4.5z" />
                                        </svg>
                                    </button>

                                    <form method="post" asp-page-handler="Delete" class="adm-inline-form"
                                          data-confirm="Hapus peran &quot;@item.Name&quot;?">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="adm-btn adm-btn-icon is-danger" title="Hapus"
                                                disabled="@(item.IsSuperAdmin || item.UserCount > 0)">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <polyline points="3 6 21 6" />
                                                <path d="M8 6V4.5A1.5 1.5 0 0 1 9.5 3h5A1.5 1.5 0 0 1 16 4.5V6" />
                                                <path d="M6 6v13.5A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V6" />
                                            </svg>
                                        </button>
                                    </form>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="_AdminPager" model="Model" />
</section>

<div class="adm-modal" id="roleDialog" role="dialog" aria-modal="true" aria-labelledby="roleDialogTitle"
     hidden data-open-on-load="@(Model.ReopenDialog ? "true" : "false")">
    <div class="adm-modal-box is-wide">
        <form method="post" asp-page-handler="Save">
            <input type="hidden" name="Input.Id" data-name="id" value="@Model.Input.Id" />

            <div class="adm-modal-head">
                <div>
                    <h3 id="roleDialogTitle" data-modal-title>@(isEdit ? "Ubah Peran" : "Tambah Peran")</h3>
                    <p>Kode peran dipakai kode program, jadi sebaiknya tidak diubah setelah dipakai.</p>
                </div>
                <button type="button" class="adm-modal-close" data-modal-close aria-label="Tutup">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                        <line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
                    </svg>
                </button>
            </div>

            <div class="adm-modal-body">
                <div asp-validation-summary="ModelOnly" class="adm-alert adm-alert-error adm-validation-summary"></div>

                <div class="adm-form-grid">
                    <div class="adm-field">
                        <label for="roleCode">Kode<span class="adm-req">*</span></label>
                        <input id="roleCode" type="text" name="Input.Code" data-name="code" data-autofocus
                               value="@Model.Input.Code" maxlength="50" required
                               placeholder="mis. ADMIN_KEU" autocomplete="off" spellcheck="false" />
                        <span class="adm-hint">Huruf, angka, dan garis bawah. Otomatis menjadi huruf besar.</span>
                        <span asp-validation-for="Input.Code" class="adm-validation"></span>
                    </div>

                    <div class="adm-field">
                        <label for="roleName">Nama<span class="adm-req">*</span></label>
                        <input id="roleName" type="text" name="Input.Name" data-name="name"
                               value="@Model.Input.Name" maxlength="100" required
                               placeholder="mis. Admin Keuangan" autocomplete="off" />
                        <span asp-validation-for="Input.Name" class="adm-validation"></span>
                    </div>

                    <div class="adm-field adm-field-full">
                        <label for="roleDescription">Keterangan</label>
                        <textarea id="roleDescription" name="Input.Description" data-name="description"
                                  maxlength="1000" placeholder="Ruang lingkup tugas pemegang peran ini">@Model.Input.Description</textarea>
                        <span asp-validation-for="Input.Description" class="adm-validation"></span>
                    </div>
                </div>

                <p class="adm-section-label">Izin</p>

                @if (Model.PermissionGroups.Count == 0)
                {
                    <p class="adm-hint">
                        Belum ada izin aktif. Tambahkan lebih dulu di menu <strong>Izin</strong>.
                    </p>
                }
                else
                {
                    <p class="adm-hint" style="margin-bottom:12px;">
                        Peran <span class="adm-mono">SUPERADMIN</span> tidak perlu dicentang apa pun &mdash;
                        peran itu selalu lolos seluruh pemeriksaan izin, termasuk izin yang ditambahkan kemudian.
                    </p>

                    foreach (var group in Model.PermissionGroups)
                    {
                        <div class="adm-perm-group">
                            <header>@group.Key</header>
                            <div class="adm-perm-list">
                                @foreach (var permission in group)
                                {
                                    <label class="adm-perm-item">
                                        <input type="checkbox" name="Input.PermissionIds" value="@permission.Id" data-multi
                                               checked="@Model.Input.PermissionIds.Contains(permission.Id)" />
                                        <span>
                                            <b>@permission.Name</b>
                                            <small>@permission.Code</small>
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                }

                <p class="adm-section-label">Status</p>
                <label class="adm-check">
                    <input type="checkbox" name="Input.IsActive" data-name="isactive" value="true"
                           checked="@Model.Input.IsActive" />
                    <span>Aktif &mdash; izinnya berlaku bagi akun pemegang peran ini</span>
                </label>
                <input type="hidden" name="Input.IsActive" value="false" />
            </div>

            <div class="adm-modal-foot">
                <button type="button" class="adm-btn adm-btn-ghost" data-modal-close>Batal</button>
                <button type="submit" class="adm-btn adm-btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>
