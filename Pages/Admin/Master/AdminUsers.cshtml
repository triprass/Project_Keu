@page
@using Project_Keu.Infrastructure
@model Project_Keu.Pages.Admin.Master.AdminUsersModel
@inject AppTimeZone Tz
@{
    ViewData["Title"] = "Akun Admin";
    ViewData["Lead"] = "Akun pengelola aplikasi. Hak aksesnya ditentukan oleh peran yang diberikan, bukan oleh akun itu sendiri.";

    var isEdit = Model.Input.Id is not null && Model.Input.Id != Guid.Empty;
    var nowUtc = DateTime.UtcNow;

    string Moment(DateTime? utc) => utc is null ? "Belum pernah" : Tz.ToLocal(utc.Value).ToString("dd MMM yyyy HH:mm");
}

<section class="adm-card">

    <div class="adm-toolbar">
        <form method="get" class="adm-search" data-auto-submit role="search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" /><line x1="16.5" y1="16.5" x2="21" y2="21" />
            </svg>
            <input type="search" name="q" value="@Model.Search" data-auto="text"
                   placeholder="Cari nama pengguna, nama lengkap, surel" maxlength="100"
                   autocomplete="off" aria-label="Cari akun admin" />
        </form>

        <div class="adm-toolbar-actions">
            <button type="button" class="adm-btn adm-btn-primary"
                    data-modal-open="accountDialog" data-mode="create" data-title="Tambah Akun Admin"
                    data-field-id="" data-field-username="" data-field-fullname="" data-field-email=""
                    data-field-employeeid="" data-field-isactive="true" data-checked="">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Tambah Akun
            </button>
        </div>
    </div>

    @if (Model.Roles.Count == 0)
    {
        <div class="adm-alert adm-alert-info" style="margin:14px 18px 0;" role="status">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><line x1="12" y1="11" x2="12" y2="16" />
                <line x1="12" y1="7.5" x2="12" y2="7.5" />
            </svg>
            <span>Belum ada peran yang bisa diberikan. Buat peran lebih dulu di menu <strong>Peran</strong>.</span>
        </div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="adm-empty">
            <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
            </svg>
            @if (Model.HasSearch)
            {
                <strong>Tidak ada hasil</strong>
                <p>Tidak ada akun yang cocok dengan kata kunci &ldquo;@Model.Search&rdquo;.</p>
            }
            else
            {
                <strong>Belum ada akun admin</strong>
                <p>Tambahkan akun agar pengelola lain dapat masuk ke panel administrasi.</p>
            }
        </div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th class="adm-td-num">No</th>
                        <th>Akun</th>
                        <th>Peran</th>
                        <th>Masuk Terakhir</th>
                        <th>Status</th>
                        <th class="adm-td-actions">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rowNumber = Model.RowOffset; }
                    @foreach (var item in Model.Items)
                    {
                        rowNumber++;
                        var isLocked = item.LockedUntil is not null && item.LockedUntil > nowUtc;
                        var isSelf = item.Id == Model.CurrentUserId;

                        <tr>
                            <td class="adm-td-num">@rowNumber</td>
                            <td data-label="Akun">
                                <span class="adm-strong">@item.FullName</span>
                                @if (isSelf)
                                {
                                    <span class="adm-badge adm-badge-info" style="margin-left:6px;">Anda</span>
                                }
                                <br />
                                <span class="adm-muted adm-mono">@@@item.Username</span>
                                @if (!string.IsNullOrWhiteSpace(item.Email))
                                {
                                    <br />
                                    <span class="adm-muted">@item.Email</span>
                                }
                                <br />
                                @if (string.IsNullOrWhiteSpace(item.EmployeeName))
                                {
                                    <span class="adm-badge adm-badge-warn" title="Akun ini belum dapat menjawab pertanyaan">
                                        Belum tertaut pegawai
                                    </span>
                                }
                                else
                                {
                                    <span class="adm-muted">Pegawai: @item.EmployeeName</span>
                                }
                            </td>
                            <td data-label="Peran">
                                @if (item.RoleNames.Count == 0)
                                {
                                    <span class="adm-badge adm-badge-warn">Tanpa peran</span>
                                }
                                else
                                {
                                    <span class="adm-chips">
                                        @foreach (var roleName in item.RoleNames)
                                        {
                                            <span class="adm-badge adm-badge-info">@roleName</span>
                                        }
                                    </span>
                                }
                            </td>
                            <td data-label="Masuk Terakhir"><span class="adm-muted">@Moment(item.LastLoginAt)</span></td>
                            <td data-label="Status">
                                @if (isLocked)
                                {
                                    <span class="adm-badge adm-badge-danger" title="Terkunci sampai @Moment(item.LockedUntil)">
                                        <span class="adm-badge-dot"></span>Terkunci
                                    </span>
                                }
                                else
                                {
                                    <span class="adm-badge @(item.IsActive ? "adm-badge-on" : "adm-badge-off")">
                                        <span class="adm-badge-dot"></span>@(item.IsActive ? "Aktif" : "Nonaktif")
                                    </span>
                                }
                            </td>
                            <td class="adm-td-actions" data-label="Aksi">
                                <span class="adm-row-actions">
                                    <button type="button" class="adm-btn adm-btn-icon" title="Ubah akun"
                                            data-modal-open="accountDialog" data-mode="edit" data-title="Ubah Akun Admin"
                                            data-field-id="@item.Id"
                                            data-field-username="@item.Username"
                                            data-field-fullname="@item.FullName"
                                            data-field-email="@item.Email"
                                            data-field-employeeid="@item.EmployeeId"
                                            data-field-isactive="@item.IsActive.ToString().ToLowerInvariant()"
                                            data-checked="@string.Join(",", item.RoleIds)">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7.5 18.5 3 20l1.5-4.5z" />
                                        </svg>
                                    </button>

                                    <button type="button" class="adm-btn adm-btn-icon" title="Ganti kata sandi"
                                            data-modal-open="passwordDialog" data-title="Ganti Kata Sandi"
                                            data-field-id="@item.Id" data-field-account="@item.Username">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="7.5" cy="15.5" r="4.5" /><line x1="10.7" y1="12.3" x2="21" y2="2" />
                                            <line x1="18" y1="5" x2="20.5" y2="7.5" />
                                        </svg>
                                    </button>

                                    @if (isLocked)
                                    {
                                        <form method="post" asp-page-handler="Unlock" class="adm-inline-form"
                                              data-confirm="Buka kunci akun &quot;@item.Username&quot;?">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="adm-btn adm-btn-icon" title="Buka kunci akun">
                                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <rect x="3.5" y="11" width="17" height="10.5" rx="2" />
                                                    <path d="M7.5 11V7a4.5 4.5 0 0 1 8.7-1.6" />
                                                </svg>
                                            </button>
                                        </form>
                                    }

                                    <form method="post" asp-page-handler="Delete" class="adm-inline-form"
                                          data-confirm="Hapus akun &quot;@item.Username&quot;? Tindakan ini tidak bisa dibatalkan.">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="adm-btn adm-btn-icon is-danger" title="Hapus akun"
                                                disabled="@isSelf">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <polyline points="3 6 21 6" />
                                                <path d="M8 6V4.5A1.5 1.5 0 0 1 9.5 3h5A1.5 1.5 0 0 1 16 4.5V6" />
                                                <path d="M6 6v13.5A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V6" />
                                            </svg>
                                        </button>
                                    </form>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="_AdminPager" model="Model" />
</section>

@* ----------------------------------------------------------- Dialog akun *@
<div class="adm-modal" id="accountDialog" role="dialog" aria-modal="true" aria-labelledby="accountDialogTitle"
     hidden data-open-on-load="@(Model.ReopenDialogName == "accountDialog" ? "true" : "false")">
    <div class="adm-modal-box is-wide">
        <form method="post" asp-page-handler="Save">
            <input type="hidden" name="Input.Id" data-name="id" value="@Model.Input.Id" />

            <div class="adm-modal-head">
                <div>
                    <h3 id="accountDialogTitle" data-modal-title>@(isEdit ? "Ubah Akun Admin" : "Tambah Akun Admin")</h3>
                    <p>Kata sandi disimpan sebagai hash PBKDF2, tidak pernah tersimpan apa adanya.</p>
                </div>
                <button type="button" class="adm-modal-close" data-modal-close aria-label="Tutup">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                        <line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
                    </svg>
                </button>
            </div>

            <div class="adm-modal-body">
                <div asp-validation-summary="All" class="adm-alert adm-alert-error adm-validation-summary"></div>

                <div class="adm-form-grid">
                    <div class="adm-field">
                        <label for="accUsername">Nama Pengguna<span class="adm-req">*</span></label>
                        <input id="accUsername" type="text" name="Input.Username" data-name="username" data-autofocus
                               value="@Model.Input.Username" maxlength="100" required
                               placeholder="mis. adminkeu" autocomplete="off" spellcheck="false" />
                        <span class="adm-hint">Huruf, angka, titik, garis bawah, dan tanda hubung.</span>
                        <span asp-validation-for="Input.Username" class="adm-validation"></span>
                    </div>

                    <div class="adm-field">
                        <label for="accFullName">Nama Lengkap<span class="adm-req">*</span></label>
                        <input id="accFullName" type="text" name="Input.FullName" data-name="fullname"
                               value="@Model.Input.FullName" maxlength="150" required autocomplete="off" />
                        <span asp-validation-for="Input.FullName" class="adm-validation"></span>
                    </div>

                    <div class="adm-field">
                        <label for="accEmail">Surel</label>
                        <input id="accEmail" type="email" name="Input.Email" data-name="email"
                               value="@Model.Input.Email" maxlength="150" autocomplete="off" />
                        <span asp-validation-for="Input.Email" class="adm-validation"></span>
                    </div>

                    @* Tautan ke data pegawai menentukan atas nama siapa jawaban dicatat;
                       tanpa ini pemilik akun tidak bisa menjawab pertanyaan. *@
                    <div class="adm-field">
                        <label for="accEmployee">Pegawai terkait</label>
                        <select id="accEmployee" name="Input.EmployeeId" data-name="employeeid">
                            <option value="">— belum tertaut —</option>
                            @foreach (var employee in Model.Employees)
                            {
                                <option value="@employee.Id" selected="@(Model.Input.EmployeeId == employee.Id)">
                                    @employee.FullName@(string.IsNullOrWhiteSpace(employee.Nip) ? "" : $" · {employee.Nip}")
                                </option>
                            }
                        </select>
                        <span class="adm-hint">Wajib diisi bila akun ini akan dipakai menjawab pertanyaan.</span>
                        <span asp-validation-for="Input.EmployeeId" class="adm-validation"></span>
                    </div>
                </div>

                @* Kata sandi hanya diisi saat membuat akun. Untuk akun yang sudah ada,
                   penggantian sandi punya dialognya sendiri agar tidak terganti tanpa sengaja. *@
                <div data-when="create" hidden="@isEdit">
                    <p class="adm-section-label">Kata Sandi Awal</p>
                    <div class="adm-form-grid">
                        <div class="adm-field">
                            <label for="accPassword">Kata Sandi<span class="adm-req">*</span></label>
                            <input id="accPassword" type="password" name="Input.NewPassword" data-name="newpassword"
                                   maxlength="200" autocomplete="new-password" />
                            <span class="adm-hint">
                                Minimal @Project_Keu.Pages.Admin.Master.AdminUsersModel.MinPasswordLength karakter,
                                memuat huruf dan angka.
                            </span>
                            <span asp-validation-for="Input.NewPassword" class="adm-validation"></span>
                        </div>

                        <div class="adm-field">
                            <label for="accPasswordConfirm">Ulangi Kata Sandi<span class="adm-req">*</span></label>
                            <input id="accPasswordConfirm" type="password" name="Input.ConfirmPassword"
                                   data-name="confirmpassword" maxlength="200" autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="adm-validation"></span>
                        </div>
                    </div>
                </div>

                <p class="adm-section-label">Peran</p>
                @if (Model.Roles.Count == 0)
                {
                    <p class="adm-hint">Belum ada peran. Akun bisa dibuat sekarang, tetapi belum punya hak akses apa pun.</p>
                }
                else
                {
                    <div class="adm-perm-list" style="padding:0;">
                        @foreach (var role in Model.Roles)
                        {
                            <label class="adm-perm-item">
                                <input type="checkbox" name="Input.RoleIds" value="@role.Id" data-multi
                                       checked="@Model.Input.RoleIds.Contains(role.Id)"
                                       disabled="@(!role.IsActive)" />
                                <span>
                                    <b>@role.Name</b>
                                    <small>@role.Code@(role.IsActive ? "" : " · nonaktif")</small>
                                </span>
                            </label>
                        }
                    </div>
                }

                <p class="adm-section-label">Status</p>
                <label class="adm-check">
                    <input type="checkbox" name="Input.IsActive" data-name="isactive" value="true"
                           checked="@Model.Input.IsActive" />
                    <span>Aktif &mdash; boleh masuk ke panel administrasi</span>
                </label>
                <input type="hidden" name="Input.IsActive" value="false" />
            </div>

            <div class="adm-modal-foot">
                <button type="button" class="adm-btn adm-btn-ghost" data-modal-close>Batal</button>
                <button type="submit" class="adm-btn adm-btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>

@* -------------------------------------------------- Dialog ganti kata sandi *@
<div class="adm-modal" id="passwordDialog" role="dialog" aria-modal="true" aria-labelledby="passwordDialogTitle"
     hidden data-open-on-load="@(Model.ReopenDialogName == "passwordDialog" ? "true" : "false")">
    <div class="adm-modal-box">
        <form method="post" asp-page-handler="ResetPassword">
            <input type="hidden" name="Password.Id" data-name="id" value="@Model.Password.Id" />

            <div class="adm-modal-head">
                <div>
                    <h3 id="passwordDialogTitle" data-modal-title>Ganti Kata Sandi</h3>
                    <p>Kata sandi lama tidak dapat dilihat maupun dipulihkan; yang tersimpan hanya hash-nya.</p>
                </div>
                <button type="button" class="adm-modal-close" data-modal-close aria-label="Tutup">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                        <line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
                    </svg>
                </button>
            </div>

            <div class="adm-modal-body">
                <div asp-validation-summary="All" class="adm-alert adm-alert-error adm-validation-summary"></div>

                <div class="adm-field" style="margin-bottom:15px;">
                    <label for="pwdAccount">Akun</label>
                    <input id="pwdAccount" type="text" data-name="account" value="" disabled />
                </div>

                <div class="adm-form-grid">
                    <div class="adm-field">
                        <label for="pwdNew">Kata Sandi Baru<span class="adm-req">*</span></label>
                        <input id="pwdNew" type="password" name="Password.NewPassword" data-autofocus
                               maxlength="200" required autocomplete="new-password" />
                        <span class="adm-hint">
                            Minimal @Project_Keu.Pages.Admin.Master.AdminUsersModel.MinPasswordLength karakter,
                            memuat huruf dan angka.
                        </span>
                        <span asp-validation-for="Password.NewPassword" class="adm-validation"></span>
                    </div>

                    <div class="adm-field">
                        <label for="pwdConfirm">Ulangi Kata Sandi<span class="adm-req">*</span></label>
                        <input id="pwdConfirm" type="password" name="Password.ConfirmPassword"
                               maxlength="200" required autocomplete="new-password" />
                        <span asp-validation-for="Password.ConfirmPassword" class="adm-validation"></span>
                    </div>
                </div>

                <p class="adm-hint" style="margin-top:12px;">
                    Mengganti kata sandi sekaligus membuka kunci akun bila sedang terkunci.
                </p>
            </div>

            <div class="adm-modal-foot">
                <button type="button" class="adm-btn adm-btn-ghost" data-modal-close>Batal</button>
                <button type="submit" class="adm-btn adm-btn-primary">Simpan Kata Sandi</button>
            </div>
        </form>
    </div>
</div>
