@page
@model Project_Keu.Pages.Admin.Master.PermissionsModel
@{
    ViewData["Title"] = "Izin";
    ViewData["Lead"] = "Satuan hak akses yang dipakai kode program. Pemasangannya ke akun dilakukan lewat menu Peran.";

    var isEdit = Model.Input.Id is not null && Model.Input.Id != Guid.Empty;
}

<div class="adm-alert adm-alert-info" role="note">
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" /><line x1="12" y1="11" x2="12" y2="16" />
        <line x1="12" y1="7.5" x2="12" y2="7.5" />
    </svg>
    <span>
        Kode izin baru langsung bisa dipakai pada <span class="adm-mono">[Authorize(Policy = "&hellip;")]</span>
        tanpa mengubah kode program. Sebaliknya, izin yang belum dirujuk kode program mana pun
        tidak membatasi apa-apa &mdash; ia hanya tersedia untuk dipakai nanti.
    </span>
</div>

<section class="adm-card">

    <div class="adm-toolbar">
        <form method="get" class="adm-search" data-auto-submit role="search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" /><line x1="16.5" y1="16.5" x2="21" y2="21" />
            </svg>
            <input type="search" name="q" value="@Model.Search" data-auto="text"
                   placeholder="Cari kode, nama, atau kelompok izin" maxlength="100"
                   autocomplete="off" aria-label="Cari izin" />
        </form>

        <div class="adm-toolbar-actions">
            <button type="button" class="adm-btn adm-btn-primary"
                    data-modal-open="permissionDialog" data-mode="create" data-title="Tambah Izin"
                    data-field-id="" data-field-code="" data-field-name=""
                    data-field-groupname="" data-field-description="" data-field-isactive="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Tambah Izin
            </button>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="adm-empty">
            <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="7.5" cy="15.5" r="4.5" /><line x1="10.7" y1="12.3" x2="21" y2="2" />
                <line x1="18" y1="5" x2="20.5" y2="7.5" />
            </svg>
            @if (Model.HasSearch)
            {
                <strong>Tidak ada hasil</strong>
                <p>Tidak ada izin yang cocok dengan kata kunci &ldquo;@Model.Search&rdquo;.</p>
            }
            else
            {
                <strong>Belum ada izin</strong>
                <p>Jalankan skrip <span class="adm-mono">Database/001_admin_rbac.sql</span> untuk mengisi izin bawaan, atau tambahkan sendiri.</p>
            }
        </div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th class="adm-td-num">No</th>
                        <th>Kelompok</th>
                        <th>Kode</th>
                        <th>Nama</th>
                        <th>Dipakai Peran</th>
                        <th>Status</th>
                        <th class="adm-td-actions">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rowNumber = Model.RowOffset; }
                    @foreach (var item in Model.Items)
                    {
                        rowNumber++;

                        <tr>
                            <td class="adm-td-num">@rowNumber</td>
                            <td data-label="Kelompok">
                                <span class="adm-muted">@(string.IsNullOrWhiteSpace(item.GroupName) ? "Lainnya" : item.GroupName)</span>
                            </td>
                            <td data-label="Kode"><span class="adm-code">@item.Code</span></td>
                            <td data-label="Nama">
                                <span class="adm-strong">@item.Name</span>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <br />
                                    <span class="adm-clamp adm-muted">@item.Description</span>
                                }
                            </td>
                            <td data-label="Dipakai Peran">
                                @if (item.RoleCount == 0)
                                {
                                    <span class="adm-badge adm-badge-off">Belum dipakai</span>
                                }
                                else
                                {
                                    <span class="adm-chips">
                                        @foreach (var roleName in item.RoleNames)
                                        {
                                            <span class="adm-badge adm-badge-info">@roleName</span>
                                        }
                                    </span>
                                }
                            </td>
                            <td data-label="Status">
                                <span class="adm-badge @(item.IsActive ? "adm-badge-on" : "adm-badge-off")">
                                    <span class="adm-badge-dot"></span>@(item.IsActive ? "Aktif" : "Nonaktif")
                                </span>
                            </td>
                            <td class="adm-td-actions" data-label="Aksi">
                                <span class="adm-row-actions">
                                    <button type="button" class="adm-btn adm-btn-icon" title="Ubah"
                                            data-modal-open="permissionDialog" data-mode="edit" data-title="Ubah Izin"
                                            data-field-id="@item.Id"
                                            data-field-code="@item.Code"
                                            data-field-name="@item.Name"
                                            data-field-groupname="@item.GroupName"
                                            data-field-description="@item.Description"
                                            data-field-isactive="@item.IsActive.ToString().ToLowerInvariant()">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7.5 18.5 3 20l1.5-4.5z" />
                                        </svg>
                                    </button>

                                    <form method="post" asp-page-handler="Delete" class="adm-inline-form"
                                          data-confirm="Hapus izin &quot;@item.Code&quot;?">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="adm-btn adm-btn-icon is-danger" title="Hapus"
                                                disabled="@(item.RoleCount > 0)">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <polyline points="3 6 21 6" />
                                                <path d="M8 6V4.5A1.5 1.5 0 0 1 9.5 3h5A1.5 1.5 0 0 1 16 4.5V6" />
                                                <path d="M6 6v13.5A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V6" />
                                            </svg>
                                        </button>
                                    </form>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="_AdminPager" model="Model" />
</section>

<div class="adm-modal" id="permissionDialog" role="dialog" aria-modal="true" aria-labelledby="permissionDialogTitle"
     hidden data-open-on-load="@(Model.ReopenDialog ? "true" : "false")">
    <div class="adm-modal-box">
        <form method="post" asp-page-handler="Save">
            <input type="hidden" name="Input.Id" data-name="id" value="@Model.Input.Id" />

            <div class="adm-modal-head">
                <div>
                    <h3 id="permissionDialogTitle" data-modal-title>@(isEdit ? "Ubah Izin" : "Tambah Izin")</h3>
                    <p>Mengubah kode izin yang sudah dipakai kode program akan mencabut akses yang mengandalkannya.</p>
                </div>
                <button type="button" class="adm-modal-close" data-modal-close aria-label="Tutup">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                        <line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
                    </svg>
                </button>
            </div>

            <div class="adm-modal-body">
                <div asp-validation-summary="All" class="adm-alert adm-alert-error adm-validation-summary"></div>

                <div class="adm-form-grid">
                    <div class="adm-field adm-field-full">
                        <label for="permCode">Kode<span class="adm-req">*</span></label>
                        <input id="permCode" type="text" name="Input.Code" data-name="code" data-autofocus
                               value="@Model.Input.Code" maxlength="100" required
                               placeholder="mis. reports.view" autocomplete="off" spellcheck="false" />
                        <span class="adm-hint">
                            Bergaya <span class="adm-mono">grup.aksi</span>, huruf kecil. Inilah yang ditulis pada
                            <span class="adm-mono">[Authorize(Policy = "&hellip;")]</span>.
                        </span>
                        <span asp-validation-for="Input.Code" class="adm-validation"></span>
                    </div>

                    <div class="adm-field">
                        <label for="permName">Nama<span class="adm-req">*</span></label>
                        <input id="permName" type="text" name="Input.Name" data-name="name"
                               value="@Model.Input.Name" maxlength="150" required
                               placeholder="mis. Lihat laporan" autocomplete="off" />
                        <span asp-validation-for="Input.Name" class="adm-validation"></span>
                    </div>

                    <div class="adm-field">
                        <label for="permGroup">Kelompok</label>
                        <input id="permGroup" type="text" name="Input.GroupName" data-name="groupname"
                               value="@Model.Input.GroupName" maxlength="50" list="permissionGroupList"
                               placeholder="mis. Laporan" autocomplete="off" />
                        <datalist id="permissionGroupList">
                            @foreach (var groupName in Model.KnownGroups)
                            {
                                <option value="@groupName"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Input.GroupName" class="adm-validation"></span>
                    </div>

                    <div class="adm-field adm-field-full">
                        <label for="permDescription">Keterangan</label>
                        <textarea id="permDescription" name="Input.Description" data-name="description"
                                  maxlength="1000" placeholder="Apa yang bisa dilakukan pemegang izin ini">@Model.Input.Description</textarea>
                        <span asp-validation-for="Input.Description" class="adm-validation"></span>
                    </div>

                    <div class="adm-field adm-field-full">
                        <label class="adm-check">
                            <input type="checkbox" name="Input.IsActive" data-name="isactive" value="true"
                                   checked="@Model.Input.IsActive" />
                            <span>Aktif &mdash; ikut diberikan kepada pemegang peran yang memilikinya</span>
                        </label>
                        <input type="hidden" name="Input.IsActive" value="false" />
                    </div>
                </div>
            </div>

            <div class="adm-modal-foot">
                <button type="button" class="adm-btn adm-btn-ghost" data-modal-close>Batal</button>
                <button type="submit" class="adm-btn adm-btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>
