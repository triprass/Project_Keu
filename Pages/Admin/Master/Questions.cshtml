@page
@using Microsoft.AspNetCore.Authorization
@using Project_Keu.Infrastructure
@using Project_Keu.Infrastructure.Admin
@model Project_Keu.Pages.Admin.Master.QuestionsModel
@inject IAuthorizationService Authorization
@{
    ViewData["Title"] = "Jawab Pertanyaan";
    ViewData["Lead"] = "Pilihan kategori yang muncul pada formulir saat pegawai mengajukan pertanyaan.";

    var canAnswer = (await Authorization.AuthorizeAsync(User, AdminMenu.PolicyAnswer)).Succeeded;

}

<section class="adm-card">

    <div class="adm-toolbar">
        <form method="get" class="adm-search" data-auto-submit role="search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <line x1="16.5" y1="16.5" x2="21" y2="21" />
            </svg>
            <input type="search" name="q" value="@Model.Search" data-auto="text"
                   placeholder="Cari pertanyaan" maxlength="100"
                   autocomplete="off" aria-label="Cari pertanyaan" /> 
        </form>

        @* <div class="adm-toolbar-actions">
            <button type="button" class="adm-btn adm-btn-primary"
                    data-modal-open="questionCategoryDialog" data-mode="create" data-title="Tambah Kategori Pertanyaan"
                    data-field-id="" data-field-code="" data-field-name=""
                    data-field-description="" data-field-isactive="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Tambah Kategori
            </button>
        </div> *@
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="adm-empty">
            <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.6 13.4 12.8 21a2 2 0 0 1-2.8 0l-7-7A2 2 0 0 1 2.4 12.6V5a2 2 0 0 1 2-2H12a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.6z" />
                <line x1="7.5" y1="7.5" x2="7.51" y2="7.5" />
            </svg>
            @if (Model.HasSearch)
            {
                <strong>Tidak ada hasil</strong>
                <p>Tidak ada pertanyaan yang cocok dengan kata kunci &ldquo;@Model.Search&rdquo;.</p>
            }
            else
            {
                <strong>Belum ada pertanyaan</strong>
                @* <p>Pegawai membutuhkan minimal satu kategori aktif agar bisa mengirim pertanyaan.</p> *@
            }
        </div>
    }
    else
    {
        <form method="post" asp-page="/Admin/Answer" id="answerForm"></form>

        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>Feedback</th>
                        <th>Pertanyaan</th>
                        <th>Dibuat</th>
                        <th>Status</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rowNumber = Model.RowOffset; }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td data-label="Nomor">
                                @if (canAnswer)
                                {
                                    <button type="submit" form="answerForm" name="Id" value="@item.Id"
                                            class="adm-link-btn"
                                            title="@(item.HasAnswer ? "Ubah jawaban" : "Jawab Pertanyaan")">
                                        @* title="@(item.HasAnswer ? "Ubah jawaban" : "Jawab pertanyaan") @item.QuestionNo"> *@
                                        @* <span class="adm-code">@item.QuestionNo</span> *@
                                        <span class="adm-code">Jawab</span>
                                    </button>
                                }
                                else
                                {
                                    @* <span class="adm-code">@item.QuestionNo</span> *@
                                    <span class="adm-code">Jawab</span>
                                }
                            </td>
                            @* <td data-label="Dibuat" class="adm-muted">@Model.FormatDate(item.CreatedAtUtc)</td>
                            <td data-label="Judul"><span class="adm-clamp adm-strong">@item.Title</span></td> *@
                            <td data-label="Pertanyaan">@item.QuestionText</td>
                            <td data-label="Pegawai">@item.EmployeeName</td>
                            <td data-label="Status">
                                @{
                                    // Warna mengikuti golongan yang ditentukan server, bukan
                                    // pencocokan kata "jawab" yang dulu benar untuk "Telah
                                    // Dijawab" maupun "Belum Dijawab" sekaligus.
                                    var statusClass = item.StatusKind switch
                                    {
                                        QuestionStatusKind.Answered => "adm-badge-on",
                                        QuestionStatusKind.Pending => "adm-badge-warn",
                                        _ => "adm-badge-off"
                                    };

                                    var hasColor = QuestionStatusStyle.HasUsableColor(item.StatusColor);
                                    var statusColor = QuestionStatusStyle.SafeColor(item.StatusColor);
                                }

                                @if (item.HasAnswer)
                                {
                                    <span class="adm-badge adm-badge-custom" style="border-color: #28A745;color: #28A745;">
                                        <span class="adm-badge-dot" style="background: #28A745;"></span>
                                        @item.StatusName
                                    </span>
                                }
                                else
                                {
                                    <span class="adm-badge adm-badge-custom" style="border-color: #d66a2f; color: #d66a2f;">
                                        <span class="adm-badge-dot" style="background: #d66a2f;"></span>
                                        @item.StatusName
                                    </span>
                                }
                            </td>
                            <td class="adm-td-actions" data-label="Aksi">
                                <span class="adm-row-actions">

                                    <form method="post" asp-page-handler="Delete" class="adm-inline-form"
                                          data-confirm="Hapus data pertanyaan dari &quot;@item.EmployeeName&quot;? ">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="adm-btn adm-btn-icon is-danger" title="Hapus">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:red">
                                                <polyline points="3 6 21 6" />
                                                <path d="M8 6V4.5A1.5 1.5 0 0 1 9.5 3h5A1.5 1.5 0 0 1 16 4.5V6" />
                                                <path d="M6 6v13.5A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V6" />
                                            </svg>
                                        </button>
                                    </form>
                                </span>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="_AdminPager" model="Model" />
</section>
