@page
@model Project_Keu.Pages.Admin.Master.QuestionsModel
@{
    ViewData["Title"] = "Jawab Pertanyaan";
    ViewData["Lead"] = "Pilihan kategori yang muncul pada formulir saat pegawai mengajukan pertanyaan.";

    var isEdit = Model.Input.Id is not null && Model.Input.Id != Guid.Empty;
}

<section class="adm-card">

    <div class="adm-toolbar">
        <form method="get" class="adm-search" data-auto-submit role="search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <line x1="16.5" y1="16.5" x2="21" y2="21" />
            </svg>
            @* <input type="search" name="q" value="@Model.Search" data-auto="text"
                   placeholder="Cari kode, nama, atau keterangan" maxlength="100"
                   autocomplete="off" aria-label="Cari kategori pertanyaan" /> *@
        </form>

        @* <div class="adm-toolbar-actions">
            <button type="button" class="adm-btn adm-btn-primary"
                    data-modal-open="questionCategoryDialog" data-mode="create" data-title="Tambah Kategori Pertanyaan"
                    data-field-id="" data-field-code="" data-field-name=""
                    data-field-description="" data-field-isactive="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Tambah Kategori
            </button>
        </div> *@
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="adm-empty">
            <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.6 13.4 12.8 21a2 2 0 0 1-2.8 0l-7-7A2 2 0 0 1 2.4 12.6V5a2 2 0 0 1 2-2H12a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.6z" />
                <line x1="7.5" y1="7.5" x2="7.51" y2="7.5" />
            </svg>
            @if (Model.HasSearch)
            {
                <strong>Tidak ada hasil</strong>
                <p>Tidak ada pertanyaan yang cocok dengan kata kunci &ldquo;@Model.Search&rdquo;.</p>
            }
            else
            {
                <strong>Belum ada pertanyaan</strong>
                @* <p>Pegawai membutuhkan minimal satu kategori aktif agar bisa mengirim pertanyaan.</p> *@
            }
        </div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th class="adm-td-num">No</th>
                        <th>Kode</th>
                        <th>Nama</th>
                        <th>Keterangan</th>
                        <th>Dipakai</th>
                        <th>Status</th>
                        <th class="adm-td-actions">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var rowNumber = Model.RowOffset;
                    }
                    @foreach (var item in Model.Items)
                    {
                        rowNumber++;

                        <tr>
                            <td class="adm-td-num">@rowNumber</td>
                            <td data-label="Kode"><span class="adm-code">@item.Code</span></td>
                            <td data-label="Nama"><span class="adm-strong">@item.Name</span></td>
                            <td data-label="Keterangan">
                                <span class="adm-clamp adm-muted">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</span>
                            </td>
                            <td data-label="Dipakai">
                                <span class="adm-badge adm-badge-info">@item.QuestionCount pertanyaan</span>
                            </td>
                            <td data-label="Status">
                                <span class="adm-badge @(item.IsActive ? "adm-badge-on" : "adm-badge-off")">
                                    <span class="adm-badge-dot"></span>@(item.IsActive ? "Aktif" : "Nonaktif")
                                </span>
                            </td>
                            <td class="adm-td-actions" data-label="Aksi">
                                <span class="adm-row-actions">
                                    <button type="button" class="adm-btn adm-btn-icon" title="Ubah"
                                            data-modal-open="questionCategoryDialog" data-mode="edit" data-title="Ubah Kategori Pertanyaan"
                                            data-field-id="@item.Id"
                                            data-field-code="@item.Code"
                                            data-field-name="@item.Name"
                                            data-field-description="@item.Description"
                                            data-field-isactive="@item.IsActive.ToString().ToLowerInvariant()">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7.5 18.5 3 20l1.5-4.5z" />
                                        </svg>
                                    </button>

                                    <form method="post" asp-page-handler="Delete" class="adm-inline-form"
                                          data-confirm="Hapus kategori &quot;@item.Name&quot;?">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="adm-btn adm-btn-icon is-danger" title="Hapus"
                                                disabled="@(item.QuestionCount > 0)">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <polyline points="3 6 21 6" />
                                                <path d="M8 6V4.5A1.5 1.5 0 0 1 9.5 3h5A1.5 1.5 0 0 1 16 4.5V6" />
                                                <path d="M6 6v13.5A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V6" />
                                            </svg>
                                        </button>
                                    </form>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="_AdminPager" model="Model" />
</section>

<div class="adm-modal" id="questionCategoryDialog" role="dialog" aria-modal="true"
     aria-labelledby="questionCategoryDialogTitle" hidden
     data-open-on-load="@(Model.ReopenDialog ? "true" : "false")">
    <div class="adm-modal-box">
        <form method="post" asp-page-handler="Save">
            <input type="hidden" name="Input.Id" data-name="id" value="@Model.Input.Id" />

            <div class="adm-modal-head">
                <div>
                    <h3 id="questionCategoryDialogTitle" data-modal-title>@(isEdit ? "Ubah Kategori Pertanyaan" : "Tambah Kategori Pertanyaan")</h3>
                    <p>Kategori yang dinonaktifkan tidak lagi muncul sebagai pilihan, tetapi pertanyaan lama tetap utuh.</p>
                </div>
                <button type="button" class="adm-modal-close" data-modal-close aria-label="Tutup">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                        <line x1="6" y1="6" x2="18" y2="18" />
                        <line x1="18" y1="6" x2="6" y2="18" />
                    </svg>
                </button>
            </div>

            <div class="adm-modal-body">
                <div asp-validation-summary="All" class="adm-alert adm-alert-error adm-validation-summary"></div>

                <div class="adm-form-grid">
                    <div class="adm-field">
                        <label for="qcCode">Kode<span class="adm-req">*</span></label>
                        <input id="qcCode" type="text" name="Input.Code" data-name="code" data-autofocus
                               value="@Model.Input.Code" maxlength="20" required
                               placeholder="mis. GAJI" autocomplete="off" />
                        <span asp-validation-for="Input.Code" class="adm-validation"></span>
                    </div>

                    <div class="adm-field">
                        <label for="qcName">Nama<span class="adm-req">*</span></label>
                        <input id="qcName" type="text" name="Input.Name" data-name="name"
                               value="@Model.Input.Name" maxlength="200" required
                               placeholder="mis. Gaji dan Tunjangan" autocomplete="off" />
                        <span asp-validation-for="Input.Name" class="adm-validation"></span>
                    </div>

                    <div class="adm-field adm-field-full">
                        <label for="qcDescription">Keterangan</label>
                        <textarea id="qcDescription" name="Input.Description" data-name="description"
                                  maxlength="1000" placeholder="Contoh pertanyaan yang cocok untuk kategori ini">@Model.Input.Description</textarea>
                        <span asp-validation-for="Input.Description" class="adm-validation"></span>
                    </div>

                    <div class="adm-field adm-field-full">
                        <label class="adm-check">
                            <input type="checkbox" name="Input.IsActive" data-name="isactive" value="true"
                                   checked="@Model.Input.IsActive" />
                            <span>Aktif &mdash; bisa dipilih pada formulir pertanyaan</span>
                        </label>
                        <input type="hidden" name="Input.IsActive" value="false" />
                    </div>
                </div>
            </div>

            <div class="adm-modal-foot">
                <button type="button" class="adm-btn adm-btn-ghost" data-modal-close>Batal</button>
                <button type="submit" class="adm-btn adm-btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>
