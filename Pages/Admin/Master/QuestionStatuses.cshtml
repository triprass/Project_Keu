@page
@model Project_Keu.Pages.Admin.Master.QuestionStatusesModel
@{
    ViewData["Title"] = "Status Pertanyaan";
    ViewData["Lead"] = "Tahapan penanganan pertanyaan beserta warna lencana yang dipakai di seluruh aplikasi.";

    var isEdit = Model.Input.Id is not null && Model.Input.Id != Guid.Empty;
}

<section class="adm-card">

    <div class="adm-toolbar">
        <form method="get" class="adm-search" data-auto-submit role="search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" /><line x1="16.5" y1="16.5" x2="21" y2="21" />
            </svg>
            <input type="search" name="q" value="@Model.Search" data-auto="text"
                   placeholder="Cari kode atau nama status" maxlength="100"
                   autocomplete="off" aria-label="Cari status pertanyaan" />
        </form>

        <div class="adm-toolbar-actions">
            <button type="button" class="adm-btn adm-btn-primary"
                    data-modal-open="statusDialog" data-mode="create" data-title="Tambah Status"
                    data-field-id="" data-field-code="" data-field-name=""
                    data-field-color="#0f9d63" data-field-isactive="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Tambah Status
            </button>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="adm-empty">
            <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 21V4" /><path d="M5 4.8h11.5l-1.8 3.6 1.8 3.6H5" />
            </svg>
            @if (Model.HasSearch)
            {
                <strong>Tidak ada hasil</strong>
                <p>Tidak ada status yang cocok dengan kata kunci &ldquo;@Model.Search&rdquo;.</p>
            }
            else
            {
                <strong>Belum ada status</strong>
                <p>Pertanyaan membutuhkan status agar tahap penanganannya bisa ditelusuri.</p>
            }
        </div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th class="adm-td-num">No</th>
                        <th>Kode</th>
                        <th>Nama &amp; Pratinjau</th>
                        <th>Warna</th>
                        <th>Dipakai</th>
                        <th>Status</th>
                        <th class="adm-td-actions">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rowNumber = Model.RowOffset; }
                    @foreach (var item in Model.Items)
                    {
                        rowNumber++;
                        var color = Project_Keu.Pages.Admin.Master.QuestionStatusesModel.SafeColor(item.Color);

                        <tr>
                            <td class="adm-td-num">@rowNumber</td>
                            <td data-label="Kode"><span class="adm-code">@item.Code</span></td>
                            <td data-label="Nama">
                                @* Pratinjau memakai warna yang tersimpan, sudah disaring agar
                                   isinya tidak bisa menyelipkan properti CSS lain. *@
                                <span class="adm-badge adm-badge-preview" style="color:@color; border-color:@color;">
                                    <span class="adm-badge-dot"></span>@item.Name
                                </span>
                            </td>
                            <td data-label="Warna">
                                <span class="adm-mono adm-muted">@(string.IsNullOrWhiteSpace(item.Color) ? "—" : item.Color)</span>
                            </td>
                            <td data-label="Dipakai">
                                <span class="adm-badge adm-badge-info">@item.QuestionCount pertanyaan</span>
                            </td>
                            <td data-label="Status">
                                <span class="adm-badge @(item.IsActive ? "adm-badge-on" : "adm-badge-off")">
                                    <span class="adm-badge-dot"></span>@(item.IsActive ? "Aktif" : "Nonaktif")
                                </span>
                            </td>
                            <td class="adm-td-actions" data-label="Aksi">
                                <span class="adm-row-actions">
                                    <button type="button" class="adm-btn adm-btn-icon" title="Ubah"
                                            data-modal-open="statusDialog" data-mode="edit" data-title="Ubah Status"
                                            data-field-id="@item.Id"
                                            data-field-code="@item.Code"
                                            data-field-name="@item.Name"
                                            data-field-color="@item.Color"
                                            data-field-isactive="@item.IsActive.ToString().ToLowerInvariant()">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7.5 18.5 3 20l1.5-4.5z" />
                                        </svg>
                                    </button>

                                    <form method="post" asp-page-handler="Delete" class="adm-inline-form"
                                          data-confirm="Hapus status &quot;@item.Name&quot;?">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="adm-btn adm-btn-icon is-danger" title="Hapus"
                                                disabled="@(item.QuestionCount > 0)">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <polyline points="3 6 21 6" />
                                                <path d="M8 6V4.5A1.5 1.5 0 0 1 9.5 3h5A1.5 1.5 0 0 1 16 4.5V6" />
                                                <path d="M6 6v13.5A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V6" />
                                            </svg>
                                        </button>
                                    </form>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="_AdminPager" model="Model" />
</section>

<div class="adm-modal" id="statusDialog" role="dialog" aria-modal="true" aria-labelledby="statusDialogTitle"
     hidden data-open-on-load="@(Model.ReopenDialog ? "true" : "false")">
    <div class="adm-modal-box">
        <form method="post" asp-page-handler="Save">
            <input type="hidden" name="Input.Id" data-name="id" value="@Model.Input.Id" />

            <div class="adm-modal-head">
                <div>
                    <h3 id="statusDialogTitle" data-modal-title>@(isEdit ? "Ubah Status" : "Tambah Status")</h3>
                    <p>Status yang sudah melekat pada pertanyaan tidak bisa dihapus, hanya dinonaktifkan.</p>
                </div>
                <button type="button" class="adm-modal-close" data-modal-close aria-label="Tutup">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                        <line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
                    </svg>
                </button>
            </div>

            <div class="adm-modal-body">
                <div asp-validation-summary="ModelOnly" class="adm-alert adm-alert-error adm-validation-summary"></div>

                <div class="adm-form-grid">
                    <div class="adm-field">
                        <label for="statusCode">Kode<span class="adm-req">*</span></label>
                        <input id="statusCode" type="text" name="Input.Code" data-name="code" data-autofocus
                               value="@Model.Input.Code" maxlength="20" required
                               placeholder="mis. TERJAWAB" autocomplete="off" />
                        <span asp-validation-for="Input.Code" class="adm-validation"></span>
                    </div>

                    <div class="adm-field">
                        <label for="statusName">Nama<span class="adm-req">*</span></label>
                        <input id="statusName" type="text" name="Input.Name" data-name="name"
                               value="@Model.Input.Name" maxlength="50" required
                               placeholder="mis. Sudah Dijawab" autocomplete="off" />
                        <span asp-validation-for="Input.Name" class="adm-validation"></span>
                    </div>

                    <div class="adm-field adm-field-full">
                        <label for="statusColor">Warna lencana</label>
                        <input id="statusColor" type="text" name="Input.Color" data-name="color"
                               value="@Model.Input.Color" maxlength="30"
                               placeholder="#0f9d63" autocomplete="off" />
                        <span class="adm-hint">
                            Kode heksadesimal (<span class="adm-mono">#0f9d63</span>) atau nama warna CSS
                            (<span class="adm-mono">green</span>). Kosongkan untuk memakai warna netral.
                        </span>
                        <span asp-validation-for="Input.Color" class="adm-validation"></span>
                    </div>

                    <div class="adm-field adm-field-full">
                        <label class="adm-check">
                            <input type="checkbox" name="Input.IsActive" data-name="isactive" value="true"
                                   checked="@Model.Input.IsActive" />
                            <span>Aktif &mdash; bisa dipilih saat memperbarui pertanyaan</span>
                        </label>
                        <input type="hidden" name="Input.IsActive" value="false" />
                    </div>
                </div>
            </div>

            <div class="adm-modal-foot">
                <button type="button" class="adm-btn adm-btn-ghost" data-modal-close>Batal</button>
                <button type="submit" class="adm-btn adm-btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>
