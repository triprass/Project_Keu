# Contoh isi .env untuk WAHA di server. Salin menjadi .env di direktori compose
# (/docker/project_keu), lalu isi nilainya. JANGAN commit berkas .env itu.
#
#   cp .env.waha.example .env
#
# Buat kunci acak yang kuat, jangan diketik sendiri:
#   openssl rand -hex 32

# Membuat "docker compose ..." tanpa flag -f tetap membaca kedua berkas.
# Penting: skrip deploy di .github/workflows/docker-image.yml menjalankan
# "docker compose pull" dan "up -d" polos, sehingga tanpa baris ini WAHA tidak
# akan ikut terkelola oleh deploy otomatis.
COMPOSE_FILE=docker-compose.yml:docker-compose.waha.prod.yml

# Dipakai bersama oleh WAHA (sebagai header X-Api-Key yang diterima) dan
# aplikasi (sebagai kunci yang dikirim). Keduanya harus bernilai sama.
WAHA_API_KEY=

# Masuk ke dasbor WAHA saat pemindaian QR. Hanya terjangkau lewat terowongan
# SSH, tetapi tetap jangan dibiarkan bernilai mudah ditebak.
WAHA_DASHBOARD_USER=admin
WAHA_DASHBOARD_PASSWORD=

# Nama sesi WhatsApp. Cukup satu untuk satu nomor resmi.
WAHA_SESSION=default

# Port di sisi host, tetap terikat ke 127.0.0.1. Ubah hanya bila 3000 sudah
# dipakai layanan lain di server yang sama.
WAHA_PORT=3000

# Tautan yang disisipkan di akhir setiap pesan. Kosongkan bila tidak perlu.
PORTAL_URL=

TZ=Asia/Jayapura
